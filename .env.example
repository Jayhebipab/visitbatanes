# Canonical site URL — used by metadata, OpenGraph, sitemap.xml, robots.txt, JSON-LD.
# Set this to your production domain on Vercel (Settings → Environment Variables).
NEXT_PUBLIC_SITE_URL="https://visitbatanes.vercel.app"

# Google Analytics 4 — Measurement ID from analytics.google.com (Admin → Data Streams → Web).
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=""

# Google Search Console verification token — from search.google.com/search-console.
# Use the "HTML tag" verification method and paste only the content="..." value here.
GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools verification — optional, from bing.com/webmasters.
# Use the "Meta tag" verification method (msvalidate.01).
BING_SITE_VERIFICATION=""

# Yandex Webmaster verification — optional, from webmaster.yandex.com.
# Helps for Russia/CIS market traffic.
YANDEX_SITE_VERIFICATION=""
